/*
    Creating a view to check for cases where a launch has failed,
    This view helps us gather information on which launches failed and which components caused those issues
*/
GO
CREATE VIEW failure_ship (Launch_ID, Launch_Name, Reason_for_Failure, Ship_ID, Ship_Name, Ship_model, Ship_Roles, Ship_Info)
AS
SELECT launches.launch_id, launches.name, launches.failures, launches.ship_id, ships.name, ships.model, ships.roles, ships.imo AS Ship_Info
FROM launches RIGHT JOIN ships 
ON launches.ship_id = ships.ship_id
WHERE launches.failures IS NOT NULL
GO

SELECT * FROM failure_ship

