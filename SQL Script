/* 
    Creating an audit table for capsules table
*/

GO
CREATE TABLE capsules_audit (
    AuditID INT IDENTITY(1,1) PRIMARY KEY,
    capsule_id NVARCHAR(50),
    serial NVARCHAR(50),
    status NVARCHAR(50),
    reuse_count TINYINT,
    water_landings TINYINT,
    land_landings TINYINT,
    ChangeType NVARCHAR(10),  -- Could be 'INSERT', 'UPDATE', or 'DELETE'
    ChangeDateTime DATETIME,
    OldSerial NVARCHAR(50) NULL,
    OldStatus NVARCHAR(50) NULL,
    OldReuseCount TINYINT NULL,
    OldWaterLandings TINYINT NULL,
    OldLandLandings TINYINT NULL
);
GO

-- ============================================================================================================================================================================================================================================================

/*
    Trigger for INSERT statement
*/

GO
CREATE TRIGGER trg_capsules_Insert
ON capsules
AFTER INSERT
AS
BEGIN
    INSERT INTO capsules_audit (capsule_id, serial, status, reuse_count, water_landings, land_landings, ChangeType, ChangeDateTime)
    SELECT capsule_id, serial, status, reuse_count, water_landings, land_landings, 'INSERT', GETDATE()
    FROM inserted;
END;
GO

-- ============================================================================================================================================================================================================================================================

/*
    Trigger for UPDATE statement
*/

GO
CREATE TRIGGER trg_capsules_Update
ON capsules
AFTER UPDATE
AS
BEGIN
    INSERT INTO capsules_audit (capsule_id, serial, status, reuse_count, water_landings, land_landings, ChangeType, ChangeDateTime,
        OldSerial, OldStatus, OldReuseCount, OldWaterLandings, OldLandLandings)
    SELECT i.capsule_id, i.serial, i.status, i.reuse_count, i.water_landings, i.land_landings, 'UPDATE', GETDATE(),
           d.serial, d.status, d.reuse_count, d.water_landings, d.land_landings
    FROM inserted i
    INNER JOIN deleted d ON i.capsule_id = d.capsule_id;
END;
GO

