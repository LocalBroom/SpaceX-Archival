/*
    Creating a cursor,
    This cursor lets us view a rockets status, location and owner, 
    This can be used to budget for transportation costs, commission costs launch site costs etc.
*/

-- ============================================================================================================================================================================================================================================================

GO
DECLARE cursor_mission CURSOR FOR 
SELECT launch_id, launches.name, active, country, company
FROM launches JOIN rockets
ON launches.rocket_id = rockets.rocket_id
WHERE active = 'True';

DECLARE @COUNTER INT = 10;
DECLARE @ID NVARCHAR(50);
DECLARE @NAME NVARCHAR(50);
DECLARE @ACTIVE CHAR(10);
DECLARE @COUNTRY NVARCHAR(50);
DECLARE @COMPANY NVARCHAR(50);

OPEN cursor_mission 
FETCH NEXT FROM cursor_mission INTO @ID, @NAME, @ACTIVE, @COUNTRY, @COMPANY;
WHILE @@FETCH_STATUS = 0 
BEGIN
PRINT 'The launch with ID: ' + @ID + ', Name: ' + @NAME + ', Is Rocket Active(T/F): ' + @ACTIVE + ', Rocket is in the country: ' + @COUNTRY + ', And is currently owned by: ' + @COMPANY;
FETCH NEXT FROM cursor_mission INTO @ID, @NAME, @ACTIVE, @COUNTRY, @COMPANY;
END;
CLOSE cursor_mission;
DEALLOCATE cursor_mission;
GO

