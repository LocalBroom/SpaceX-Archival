/*
    Creating a view to check the budget for a specific launch site,
    This view helps us see whether that certain launch site is viable for our mission on a budget restriciton (in this case rockets)
*/
GO
CREATE VIEW budget_launch
AS 
SELECT launches.launch_id, launches.launchpad_id, launches.rocket_id, rockets.country AS rocket_country, launchpads.name AS launch_site, rockets.mass_kg, rockets.cost_per_launch, launchpads.timezone
FROM launches 
RIGHT JOIN launchpads
ON launches.launchpad_id = launchpads.launchpad_id
RIGHT JOIN rockets
ON launches.rocket_id = rockets.rocket_id 
WHERE launchpads.launchpad_id = '5e9e4501f509094ba4566f84' AND rockets.cost_per_launch > 1000000
GO

SELECT * FROM budget_launch

