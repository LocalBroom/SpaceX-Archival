/*
    Creating a view to see how many times a core and a capsule have been reused,
    This view show cases how many times a core and a capsule have been reused, IE if they've been used more than once,
    This can help us decide if we want to decommission that module or reuse it again
*/

GO 
CREATE VIEW reuse_count
AS
SELECT launches.launch_id, launches.capsule_id, launches.core_id, capsules.serial AS capsules_serial, cores.serial AS core_serial, capsules.reuse_count AS capsule_reuse_count, cores.reuse_count AS cores_reuse_count
FROM launches
RIGHT JOIN capsules
ON launches.capsule_id = capsules.capsule_id
LEFT JOIN cores 
ON launches.core_id = cores.core_id
WHERE capsules.reuse_count > 0 AND cores.reuse_count > 0
GO 

SELECT * FROM reuse_count

