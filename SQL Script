/* 
	Creating the Launches table
	The Primary key here is the launch_id
	The Foreign keys are the rocket_id, launchpad_id, ships_id, payload_id, capsule_id and core_id
*/

CREATE TABLE launches (
  launch_id NVARCHAR(50) NOT NULL,
  name NVARCHAR(50) NOT NULL,
  date DATETIME NOT NULL,
  rocket_id NVARCHAR(50) NOT NULL,
  launchpad_id NVARCHAR(50) NOT NULL,
  success CHAR(10) NULL,
  failures NVARCHAR(250) NULL,
  ship_id NVARCHAR(50) NOT NULL,
  capsule_id NVARCHAR(50) NOT NULL,
  payload_id NVARCHAR(250) NOT NULL,
  core_id NVARCHAR(250) NOT NULL,
  fairings_reused CHAR(10) NULL,
  fairings_recovery_attempts CHAR(10) NULL,
  fairings_recovered CHAR(10) NULL,
  --Declaring launch_id as primary key
  CONSTRAINT Launches_PKey PRIMARY KEY (launch_id),
  --Declaring rocket_id, launchpad_id, ships_id, payload_id, capsule_id and core_id as foreign keys
  CONSTRAINT Rocket_FKey FOREIGN KEY (rocket_id) REFERENCES rockets(rocket_id),
  CONSTRAINT LaunchPad_FKey FOREIGN KEY (launchpad_id) REFERENCES launchpads(launchpad_id),
  CONSTRAINT Ships_FKey FOREIGN KEY (ship_id) REFERENCES ships(ship_id),
  CONSTRAINT Capsule_FKey FOREIGN KEY (capsule_id) REFERENCES capsules(capsule_id),
  CONSTRAINT Payload_FKey FOREIGN KEY (payload_id) REFERENCES payloads(payload_id),
  CONSTRAINT Cores_FKey FOREIGN KEY (core_id) REFERENCES cores(core_id)
);
