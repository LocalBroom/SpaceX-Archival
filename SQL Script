    Creating a User-Defined Function
    This sorts data based on the active status of a payload, making sure we're aware of its usablity 
*/
IF OBJECT_ID('payload_use') IS NOT NULL
DROP FUNCTION payload_use

-- ============================================================================================================================================================================================================================================================

GO
CREATE FUNCTION payload_use
(@p_use CHAR(10) = NULL)
RETURNS TABLE
AS
RETURN(SELECT payload_id, name, type, reused, regime FROM payloads 
WHERE reused = @p_use)
