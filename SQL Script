/* 
    Creating a stored procedure for Launch Dates,
    This Procedure helps us retrieve launches that have taken place during a certain time period
*/
IF OBJECT_ID('LaunchDates') IS NOT NULL 
DROP PROCEDURE LaunchDates

-- ============================================================================================================================================================================================================================================================

GO 
CREATE PROCEDURE LaunchDates
@DateMIN VARCHAR(100) = NULL,
@DateMAX VARCHAR(100) = NULL
AS
BEGIN
IF @DateMIN IS NULL OR @DateMAX IS NULL
BEGIN;
THROW 50001, 'ERROR, NO VALID INPUT GIVEN', 1;
END;
IF TRY_CAST(@DateMIN AS DATE) IS NULL
BEGIN;
THROW 50003, 'ERROR, MINDATE NOT VALID', 1;
END;
IF TRY_CAST(@DateMAX AS DATE) IS NULL
BEGIN;
THROW 50004, 'ERROR MAX DATE NOT VALID', 1;
END;

DECLARE @Start DATE = CAST(@DateMIN AS DATE);
DECLARE @End DATE = CAST(@DateMAX AS DATE);

IF @Start >= @End
BEGIN;
THROW 50002, 'INVALID INPUT, DATES CANNOT BE ORDERED IN THIS WAY', 1;
END;

SELECT launch_id, name, date, rocket_id, launchpad_id, success, failures FROM launches
WHERE launches.date >= @Start
AND launches.date <= @End
ORDER BY launches.date ASC;
END;
GO

